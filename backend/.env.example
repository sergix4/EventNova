# Renombrar este archivo a ".env" y completar con los valores reales
# NUNCA subir el archivo ".env" real a GitHub

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventnova_db
DB_USER=eventnova_user
DB_PASSWORD=tu_contraseña_aqui

# Neon Postgres (opcional). Si se define, reemplaza a DB_HOST, DB_PORT, DB_NAME, DB_USER y DB_PASSWORD
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# Sesion
SESSION_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
